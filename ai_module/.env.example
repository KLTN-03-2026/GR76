# =============================================
# AI Module Environment Variables
# =============================================
# Copy file này thành .env và điền giá trị thực

# Groq API Key (bắt buộc cho Vision AI)
# Lấy key miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY_HERE

# Port cho AI service (mặc định 8001)
AI_PORT=8001
